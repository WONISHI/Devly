{
  "name": "devly",
  "version": "0.2.0-preview.1",
  "description": "A local desktop AI coding workspace with custom model providers",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "volta": {
    "node": "24.7.0",
    "pnpm": "10.34.9"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "pnpm typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "pack": "pnpm build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "dist": "pnpm build && electron-builder --config.electronDist=node_modules/electron/dist",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:codex": "node scripts/verify-codex.mjs",
    "verify:desktop": "node scripts/smoke-desktop.mjs",
    "check": "node scripts/check.mjs",
    "build:bundle": "electron-vite build",
    "audit:dependencies": "node scripts/dependency-inventory.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "verify:icons": "node scripts/provider-icons.mjs",
    "verify:usage-ui": "node scripts/smoke-usage.mjs",
    "verify:provider-icons": "node scripts/smoke-provider-icons.mjs",
    "verify:chat": "node scripts/verify-chat.mjs",
    "verify:agent": "node scripts/verify-agent.mjs",
    "verify:agent-ui": "node scripts/smoke-agent.mjs",
    "verify:chat-ui": "node scripts/smoke-chat.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:no-codex": "node scripts/verify-no-codex.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:persistence": "node scripts/smoke-persistence.mjs",
    "verify:provider": "node scripts/smoke-provider.mjs",
    "verify:model-picker": "node scripts/smoke-model-picker.mjs",
    "verify:execution": "node scripts/verify-execution.mjs",
    "verify:execution-ui": "node scripts/smoke-execution.mjs",
    "verify:execution-host": "DEVLY_VERIFY_HOST_EXECUTION=1 vitest run tests/host-execution.test.ts tests/execution-foundation.test.ts",
    "verify:editor": "node scripts/verify-editor.mjs",
    "verify:editor-ui": "node scripts/smoke-editor.mjs",
    "verify:editor-live": "node scripts/verify-editor-live.mjs",
    "verify:git-workspace": "node scripts/verify-git-workspace.mjs",
    "verify:terminal": "node scripts/verify-terminal.mjs",
    "verify:workbench-ui": "node scripts/smoke-workbench.mjs",
    "verify:results-ui": "node scripts/smoke-results.mjs",
    "verify:workbench-host": "DEVLY_VERIFY_HOST_EXECUTION=1 vitest run tests/git-workspace-host.test.ts tests/host-execution.test.ts tests/execution-foundation.test.ts",
    "verify:stability": "node scripts/verify-stability.mjs",
    "verify:protocols": "node scripts/verify-protocols.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "verify:lifecycle": "node scripts/verify-lifecycle.mjs",
    "verify:storage-faults": "node scripts/verify-storage-faults.mjs",
    "verify:configuration": "node scripts/verify-configuration.mjs",
    "verify:performance-ui": "node scripts/smoke-performance.mjs",
    "verify:stability-ui": "node scripts/smoke-stability.mjs",
    "verify:extensions": "node scripts/verify-extensions.mjs",
    "verify:workspaces": "node scripts/verify-workspaces.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:skills": "node scripts/verify-skills.mjs",
    "verify:multitask": "node scripts/verify-multitask.mjs",
    "verify:extensions-ui": "node scripts/smoke-extensions.mjs",
    "verify:web": "node scripts/verify-web.mjs",
    "verify:attachments": "node scripts/verify-attachments.mjs",
    "verify:preview-ui": "node scripts/smoke-preview.mjs",
    "verify:worker-close": "node scripts/verify-worker-close.mjs",
    "verify:browser-ui": "node scripts/smoke-browser.mjs",
    "verify:browser-proxy": "node scripts/browser-proxy.integration.mjs",
    "verify:schedules": "node scripts/verify-schedules.mjs",
    "verify:stage11-ui": "node scripts/smoke-stage11.mjs",
    "verify:stage11-suite": "node scripts/verify-stage11-suite.mjs",
    "verify:windows-restrictions": "node scripts/verify-windows-restrictions.mjs",
    "preview:mac": "pnpm build && electron-builder --mac dmg --arm64 --config.electronDist=node_modules/electron/dist --config.mac.identity=null --publish never",
    "verify:mac-install": "node scripts/verify-mac-install.mjs",
    "archive:preview": "node scripts/archive-preview.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-use-controllable-state": "1.3.0",
    "@streamdown/cjk": "^1.0.5",
    "@streamdown/code": "^2.0.1",
    "@streamdown/math": "^1.0.4",
    "@streamdown/mermaid": "^1.0.4",
    "@tanstack/react-virtual": "^3.13.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^6.0.333",
    "ajv": "8.20.0",
    "ansi-to-react": "6.2.6",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "electron-log": "^5.4.0",
    "ignore": "7.0.16",
    "katex": "0.18.2",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "motion": "12.42.0",
    "nanoid": "3.3.20",
    "node-pty": "^1.1.0",
    "parse5": "8.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "sonner": "^2.0.0",
    "streamdown": "^2.8.0",
    "tailwind-merge": "^3.0.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
